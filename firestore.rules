rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'creativeswiftng@gmail.com' ||
        request.auth.token.email == 'densuredconsult@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // Students Directory
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Tuition Payments & Clearance Transactions
    match /payments/{paymentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Admissions & Registration Applications
    match /applications/{applicationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Study Materials
    match /materials/{materialId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // CBT Exams
    match /cbt_exams/{examId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Practice Questions
    match /practice_questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Gallery & Campus Media
    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Admin Users
    match /admin_users/{adminId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Payment Submissions
    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Official Tuition Receipts
    match /receipts/{receiptId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
